# Copy to .env.local. Everything is optional: without keys the app runs in
# simulated mode (PayPal calls are simulated, AI falls back to a rule planner).

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id from the sandbox app's webhook settings
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Free Google AI Studio key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
