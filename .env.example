# Copy to .env.local. Everything is optional: without keys the app runs with simulated PayPal
# calls and a rule-based AI fallback.

# Required in production (16+ random characters). Dev has a built-in default.
SESSION_SECRET=

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Enable Invoicing and Payouts on the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Free Google AI Studio key (aistudio.google.com/apikey)
KITTY_GEMINI_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Web Push (free). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Production database (free Turso). Leave empty locally: a SQLite file in .data/ is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
