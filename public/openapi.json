          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "paypalEmail": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not allowed"
          }
        }
      }
    },
