{
  "openapi": "3.0.3",
  "info": {
    "title": "Kitty API",
    "version": "1.0.0",
    "description": "Kitty is an AI treasurer for group money on the PayPal sandbox. The AI only proposes; a deterministic policy engine decides allow, needs_quorum or block before anything touches PayPal. Every decision lands in a hash-chained audit ledger.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local"
    }
  ],
  "security": [
    {
      "cookie": []
    },
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kitty_session"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token from POST /api/auth/tokens"
      }
    }
  },
