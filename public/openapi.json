    "/api/kitties/{id}/action": {
      "post": {
        "tags": [
          "Agent"
        ],
        "summary": "Run one typed action through the policy engine: allow, needs_quorum or block",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "request_contributions",
                          "send_reminders",
                          "pay_vendor",
                          "record_cash",
                          "refund_member",
                          "void_payout",
                          "drop_member",
                          "update_mandate",
                          "release_hold",
                          "capture_hold",
                          "void_hold"
                        ]
                      },
                      "params": {
                        "type": "object"
                      }
                    }
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
